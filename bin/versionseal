#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ -z "${KUJO_BIN:-}" ]; then
    if command -v kujo >/dev/null 2>&1; then KUJO_BIN=$(command -v kujo)
    elif [ -x "$ROOT/../kujo/target/release/kujo" ]; then KUJO_BIN="$ROOT/../kujo/target/release/kujo"
    elif [ -x "$ROOT/../kujo/target/release/kujo.exe" ]; then KUJO_BIN="$ROOT/../kujo/target/release/kujo.exe"
    else printf 'versionseal: Kujo runtime not found; set KUJO_BIN.\n' >&2; exit 2
    fi
fi
exec "$KUJO_BIN" run "$ROOT/versionseal.kujo" -- "$@"
