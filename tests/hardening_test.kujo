from src.hardening import verify_signature, evaluate_approval_policy, evaluate_expiry, merge_replicas, contention_result
mut pass:=0;mut fail:=0;func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
fixture:=parse_json(read_file("fixtures/signatures/rsa-public-key.json"));fixture["offline"]=true;check(verify_signature(fixture["message"],fixture["signature"],fixture)["ok"],"RSA fixture");check(!verify_signature(fixture["message"]+"-drift",fixture["signature"],fixture)["ok"],"RSA drift")
policy:={"quorum":2,"separation_of_duties":true,"required_roles":["editor","publisher"],"forbidden_role_pairs":[["requester","publisher"]]};decisions:=[{"decision":"approve","actor":"alice","role":"editor"},{"decision":"approve","actor":"bob","role":"publisher"}];check(evaluate_approval_policy(policy,decisions)["approved"],"quorum and separation");check(!evaluate_approval_policy(policy,[decisions[0]])["approved"],"quorum rejection")
check(!evaluate_expiry("2026-08-15T00:00:00Z","2026-08-14T00:00:00Z")["expired"],"not expired");check(evaluate_expiry("2026-08-15T00:00:00Z","2026-08-15T00:00:00Z")["expired"],"expired with injected clock")
left:=[{"id":"approval-one","record_type":"decision","origin_host":"host-a","replica_version":1}];right:=[{"id":"approval-one","record_type":"revoke","origin_host":"host-b","replica_version":1}];merged:=merge_replicas(left,right);check(merged["ok"]&&merged["records"][0]["record_type"]=="revoke"&&merged["revocation_precedence"],"replication revocation");conflict:=merge_replicas(left,[{"id":"approval-one","record_type":"decision","origin_host":"host-b","replica_version":1,"changed":true}]);check(!conflict["ok"]&&len(conflict["conflicts"])==1,"replication conflict")
check(contention_result("macos",32,32)["ok"],"contention receipt");print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
