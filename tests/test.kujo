from tests.support import test_root
from src.common import has
from src.core import dispatch
from src.args import parse_args
mut pass:=0;mut fail:=0
func check(ok,label){if ok{pass=pass+1}else{fail=fail+1;eprint("FAIL: "+label)}}
root:=test_root("versionseal-test")
func opts(v){return parse_args(v,["json","dry-run","force","act","yes"])}
check(dispatch("init",opts(["--state",root]))["ok"],"init")
manifest:=root+"-manifest";write_file(manifest,"approved bytes",true);input:=root+"-approval.json";write_file(input,"{\"schema_version\":\"1.0.0\",\"human_actor\":\"fixture-human\",\"package_id\":\"package-fixture\",\"package_version\":\"1\",\"manifest_checksum\":\""+sha256_file(manifest)+"\",\"destination\":\"local\",\"action\":\"publish\"}",true)
created:=dispatch("approve",opts(["--state",root,"--input",input,"--path",manifest,"--actor","fixture-human","--timestamp","2026-08-14T00:00:00Z"]))
check(created["ok"],"core workflow");id:="";if created["ok"]{id=created["value"]["record"]["id"]}
check(!dispatch("approve",opts(["--state",root,"--input",input,"--path",manifest,"--actor","fixture-human","--timestamp","2026-08-14T00:00:00Z"]))["ok"],"duplicate")
check(!dispatch("approve",opts(["--state",root,"--input","fixtures/core.json"]))["ok"],"actor required")
check(!dispatch("show",opts(["--state",root,"--id","../escape"]))["ok"],"traversal")
bad:=root+"/bad.json";write_file(bad,"{",true);check(!dispatch("approve",opts(["--state",root,"--input",bad,"--actor","fixture-human"]))["ok"],"malformed JSON")
future:=root+"/future.json";write_file(future,"{\"schema_version\":\"2.0.0\"}",true);check(!dispatch("approve",opts(["--state",root,"--input",future,"--actor","fixture-human"]))["ok"],"schema major")
check(dispatch("approve",opts(["--state",root,"--input",input,"--path",manifest,"--actor","fixture-human","--dry-run"]))["value"]["dry_run"],"dry run")
check(dispatch("doctor",opts(["--state",root]))["value"]["healthy"],"doctor")
check(dispatch("version",opts([]))["value"]["version"]=="0.3.0","version")
release_version:=trim(read_file("VERSION"))
check(release_version==dispatch("version",opts([]))["value"]["version"],"release version matches runtime")
record_schema:=parse_json(read_file("schemas/record.schema.json"))
check(has(record_schema["properties"]["tool_version"]["enum"],release_version),"schema accepts current release records")
check(created["value"]["record"]["tool_version"]==release_version,"new records carry release version")
check(dispatch("export",opts(["--state",root]))["value"]["schema_version"]=="1.0.0","export")
if id!=""{check(dispatch("show",opts(["--state",root,"--id",id]))["ok"],"show")}
if id!=""{record_path:=root+"/records/"+id+".json";legacy:=parse_json(read_file(record_path));for legacy_version in ["0.1.0","0.2.0"] { legacy["tool_version"]=legacy_version;write_file(record_path,to_json_pretty(legacy)+"\n",true);check(dispatch("validate",opts(["--state",root,"--id",id]))["ok"],legacy_version+" record compatibility") }}
artifact:=root+"/package.bin";write_file(artifact,"approved",true);bound_input:=root+"/bound.json";write_file(bound_input,"{\"schema_version\":\"1.0.0\",\"human_actor\":\"fixture-human\",\"package_id\":\"package-2\",\"package_version\":\"2\",\"manifest_checksum\":\""+sha256_file(artifact)+"\",\"destination\":\"local\",\"action\":\"publish\"}",true)
bound:=dispatch("approve",opts(["--state",root,"--input",bound_input,"--actor","fixture-human","--timestamp","2026-08-14T00:00:01Z","--path",artifact]))
check(bound["ok"],"approval binds package bytes")
if bound["ok"]{bound_id:=bound["value"]["record"]["id"];check(dispatch("verify",opts(["--state",root,"--id",bound_id,"--path",artifact]))["ok"],"unchanged package verifies");append_file(artifact,"x");check(!dispatch("verify",opts(["--state",root,"--id",bound_id,"--path",artifact]))["ok"],"one-byte drift invalidates approval")}
print(to_string(pass)+" passed; "+to_string(fail)+" failed");if fail>0{exit(1)}
