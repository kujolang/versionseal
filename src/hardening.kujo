from src.common import get, has, canonical_json, valid_timestamp

export func verify_signature(message,signature,adapter){if type(adapter)!="dict"||get(adapter,"offline",false)!=true{return {"ok":false,"error":"signature adapter must be explicitly offline"}};algorithm:=get(adapter,"algorithm","");if algorithm=="rsa-sha256"{public_key:=get(adapter,"public_key","");if type(public_key)!="string"||public_key==""{return {"ok":false,"error":"RSA public key is required"}};if rsa_verify(message,signature,public_key)!=true{return {"ok":false,"error":"signature mismatch"}};return {"ok":true,"verified":true,"algorithm":algorithm}};if algorithm=="hmac-sha256"{verification_key:=get(adapter,"verification_key","");if type(verification_key)!="string"||len(verification_key)<16{return {"ok":false,"error":"explicit HMAC verification key is required"}};if hmac_sha256(verification_key,message)!=signature{return {"ok":false,"error":"signature mismatch"}};return {"ok":true,"verified":true,"algorithm":algorithm}};return {"ok":false,"error":"unsupported signature algorithm"}}

export func evaluate_approval_policy(policy,decisions){if type(policy)!="dict"||type(decisions)!="array"||len(decisions)>1000{return {"ok":false,"error":"bounded policy and decisions required"}};quorum:=get(policy,"quorum",0);if quorum<1||quorum>100{return {"ok":false,"error":"quorum must be 1..100"}};mut approvers:=[];mut roles:=[];for decision in decisions{if get(decision,"decision","")=="approve"{actor:=get(decision,"actor","");role:=get(decision,"role","");if actor!=""&&!has(approvers,actor){approvers=push(approvers,actor)};if role!=""&&!has(roles,role){roles=push(roles,role)}}};if get(policy,"separation_of_duties",false)==true{for forbidden in get(policy,"forbidden_role_pairs",[]){if type(forbidden)=="array"&&len(forbidden)==2&&has(roles,forbidden[0])&&has(roles,forbidden[1]){return {"ok":false,"error":"forbidden role combination"}}}};required_roles:=get(policy,"required_roles",[]);mut missing:=[];for role in required_roles{if !has(roles,role){missing=push(missing,role)}};approved:=len(approvers)>=quorum&&len(missing)==0;return {"ok":true,"approved":approved,"quorum":quorum,"approver_count":len(approvers),"missing_roles":missing}}

export func evaluate_expiry(expires_at,current_time){if !valid_timestamp(expires_at)||!valid_timestamp(current_time){return {"ok":false,"error":"expires_at and injected current_time must be RFC 3339 UTC"}};return {"ok":true,"expired":current_time>=expires_at,"expires_at":expires_at,"evaluated_at":current_time,"clock":"injected"}}

export func merge_replicas(left,right){if type(left)!="array"||type(right)!="array"||len(left)+len(right)>10000{return {"ok":false,"error":"replicas must be bounded arrays"}};mut merged:={};mut conflicts:=[];for record in concat(left,right){id:=get(record,"id","");host:=get(record,"origin_host","");version:=get(record,"replica_version",0);if id==""||host==""||version<1{return {"ok":false,"error":"replicated records require id, origin_host, and replica_version"}};if has_key(merged,id)==0{merged[id]=record}else{existing:=merged[id];if get(record,"record_type","")=="revoke"&&get(existing,"record_type","")!="revoke"{merged[id]=record}else if get(existing,"record_type","")=="revoke"{}else if canonical_json(existing)!=canonical_json(record){if version>get(existing,"replica_version",0){merged[id]=record}else if version==get(existing,"replica_version",0){conflicts=push(conflicts,{"id":id,"left_host":get(existing,"origin_host",""),"right_host":host,"reason":"equal-version-divergence"})}}}};mut records:=[];for id in sort(keys(merged)){records=push(records,merged[id])};return {"ok":len(conflicts)==0,"records":records,"conflicts":conflicts,"revocation_precedence":true}}

export func contention_result(platform,attempted,stored){if !has(["linux","macos","windows"],platform)||attempted<2||stored!=attempted{return {"ok":false,"error":"contention benchmark failed or platform unsupported"}};return {"ok":true,"platform":platform,"records":stored}}
